---
// Byte sleeps on the footer line. Click (or tap) to wake her for a security tip she will
// deny giving. Pet her ten times and she calls her friends.
import PixelCat from './PixelCat.astro';
---

<div class="byte" id="byte">
  <p class="bubble mono" id="byte-says" role="status" hidden></p>
  <button class="byte-btn" type="button" aria-label="Pet Byte the cat" aria-describedby="byte-says">
    <span class="zzz mono" aria-hidden="true"><span>z</span><span>z</span><span>Z</span></span>
    <PixelCat />
  </button>
</div>

<script>
  const LINES = [
    'mrrp. (that means "rotate your API keys")',
    'purr. zero criticals today.',
    'I sat on the keyboard and found an IDOR.',
    '*knocks your session token off the table*',
    'meow. have you tried turning auth on?',
    "that's not a bug. that's a feature with a CVE.",
    "prrrt. never trust user input. or dogs.",
    "I don't do pentests. I do naptests.",
    '*stares at the CSP header approvingly*',
    'hiss. you left debug=true on in prod.',
  ];

  const root = document.getElementById('byte');
  const btn = root?.querySelector('button');
  const says = document.getElementById('byte-says');
  let timer: number | undefined;
  let pets = 0;
  let last = -1;

  btn?.addEventListener('click', () => {
    pets++;
    let i = Math.floor(Math.random() * LINES.length);
    if (i === last) i = (i + 1) % LINES.length;
    last = i;
    root?.classList.add('is-awake');
    if (says) {
      says.textContent = pets === 10 ? 'okay fine. calling the others.' : LINES[i];
      says.hidden = false;
    }
    if (pets === 10) document.dispatchEvent(new CustomEvent('catparty'));
    clearTimeout(timer);
    timer = window.setTimeout(() => {
      root?.classList.remove('is-awake');
      if (says) says.hidden = true;
    }, 4500);
  });
</script>

<style>
  .byte {
    position: absolute;
    right: var(--gutter);
    bottom: 100%;
    /* Sit on the footer's top border. */
    margin-bottom: -2px;
  }
  :global(:root[data-nocat]) .byte { display: none; }
  .byte-btn {
    position: relative;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 6px;
  }
  .byte-btn:hover :global(.l-eyesShut) { display: none; }
  .byte-btn:hover :global(.l-eyesOpen) { display: inline; }
  .zzz {
    position: absolute;
    left: 2.6rem;
    top: -1.2rem;
    display: flex;
    gap: 0.1rem;
    font-size: 0.7rem;
    color: var(--muted);
    pointer-events: none;
  }
  .zzz span { animation: float-z 3s ease-in-out infinite; opacity: 0; }
  .zzz span:nth-child(2) { animation-delay: 1s; }
  .zzz span:nth-child(3) { animation-delay: 2s; font-size: 0.85rem; }
  @keyframes float-z {
    0% { opacity: 0; transform: translateY(6px); }
    30% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-10px); }
  }
  :global(.is-awake) .zzz, .byte-btn:hover .zzz { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .zzz span { opacity: 1; animation: none; }
  }

  .bubble {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.5rem);
    width: max-content;
    max-width: min(17rem, calc(100vw - 2 * var(--gutter)));
    margin: 0;
    padding: 0.5rem 0.75rem;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--text-strong);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.12);
  }
  .bubble::after {
    content: '';
    position: absolute;
    right: 1.6rem;
    top: 100%;
    border: 7px solid transparent;
    border-top-color: var(--border);
  }
</style>
