---
// 404 scene: Byte sits on a table and knocks the page you wanted onto the floor.
import PixelCat from './PixelCat.astro';
---

<div class="scene" role="img" aria-label="Byte the pixel cat sits on a table and knocks a page labelled 404 onto the floor, then looks at you.">
  <div class="table">
    <PixelCat layers={['tailUp', 'tailDown', 'body', 'face', 'eyesSide', 'eyesOpen']} class="scene-cat" />
    <div class="page mono" aria-hidden="true"><span>404</span></div>
  </div>
</div>

<style>
  .scene { position: relative; height: 10.5rem; max-width: 22rem; margin: 1.5rem 0 1rem; }
  .table {
    position: absolute;
    left: 0;
    bottom: 3.75rem;
    width: 12rem;
    height: 0.5rem;
    background: var(--border);
    border-radius: 2px;
  }
  .table::before, .table::after {
    content: '';
    position: absolute;
    top: 100%;
    width: 0.5rem;
    height: 3.25rem;
    background: var(--border);
  }
  .table::before { left: 0.75rem; }
  .table::after { right: 0.75rem; }
  .table :global(.scene-cat) { position: absolute; left: 3rem; bottom: 100%; width: 96px; height: auto; }
  .table :global(.scene-cat .l-eyesShut) { display: none; }
  /* Looks at the page, then at you. */
  .table :global(.scene-cat .l-eyesSide) { display: inline; animation: look 5s steps(1) infinite; }
  .table :global(.scene-cat .l-eyesOpen) { display: inline; animation: look 5s steps(1) infinite reverse; }
  @keyframes look { 0%, 45% { opacity: 1; } 46%, 100% { opacity: 0; } }
  .table :global(.scene-cat) { animation: nudge 5s ease-in-out infinite; }
  @keyframes nudge { 0%, 30%, 50%, 100% { transform: none; } 38% { transform: translateX(6px) rotate(3deg); } }

  .page {
    position: absolute;
    left: 9.4rem;
    bottom: 100%;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2.6rem;
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--surface);
    border: 1px solid var(--muted);
    border-radius: 2px 8px 2px 2px;
    transform-origin: bottom left;
    animation: fall 5s ease-in infinite;
  }
  @keyframes fall {
    0%, 38% { transform: none; opacity: 1; }
    44% { transform: translateX(1.4rem) rotate(25deg); }
    62% { transform: translate(4.5rem, 6.4rem) rotate(95deg); opacity: 1; }
    90% { transform: translate(4.5rem, 6.4rem) rotate(95deg); opacity: 1; }
    100% { transform: translate(4.5rem, 6.4rem) rotate(95deg); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .page { animation: none; transform: translate(4.5rem, 6.4rem) rotate(95deg); }
    .table :global(.scene-cat .l-eyesSide) { display: none; }
  }
  :global(:root[data-calm]) .page { transform: translate(4.5rem, 6.4rem) rotate(95deg); }
  :global(:root[data-calm]) .table :global(.scene-cat .l-eyesSide) { display: none; }
</style>
