---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  variant: 'side' | 'inline';
}
const { headings, variant } = Astro.props;
const items = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');
---

{
  variant === 'side' ? (
    <nav class="toc toc-side" aria-labelledby="toc-side-label">
      <p class="toc-label" id="toc-side-label">On this page</p>
      <ol>
        {items.map((h) => (
          <li class={`d${h.depth}`}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  ) : (
    <details class="toc toc-inline">
      <summary>
        <span class="toc-label">On this page</span>
      </summary>
      <nav aria-label="On this page">
        <ol>
          {items.map((h) => (
            <li class={`d${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}

<style>
  .toc ol { list-style: none; margin: 0; padding: 0; }
  .toc li { margin: 0; line-height: 1.35; }
  .toc li + li { margin-top: 0.45rem; }
  .toc li.d3 { padding-left: 0.9rem; font-size: 0.95em; }
  .toc a { color: var(--muted); text-decoration: none; display: inline-block; }
  .toc a:hover { color: var(--accent); text-decoration: underline; }
  .toc-label {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .toc-side {
    position: sticky;
    top: 5.5rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    font-size: 0.85rem;
    padding-left: 1rem;
    border-left: 1px solid var(--border);
  }

  .toc-inline {
    margin: 0 0 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 0.95rem;
  }
  .toc-inline summary {
    cursor: pointer;
    padding: 0.75rem 1rem;
    list-style-position: inside;
  }
  .toc-inline summary .toc-label { display: inline; margin: 0 0 0 0.4rem; }
  .toc-inline nav { padding: 0 1rem 1rem; }
</style>
