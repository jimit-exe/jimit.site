---
import Base from '../../layouts/Base.astro';
import { getTags } from '../../lib/posts';
const tags = await getTags();
---

<Base title="Tags" description="Every topic tag used on jimit.site, with the number of posts for each.">
  <div class="container page">
    <p class="prompt">ls ~/tags</p>
    <h1>Tags</h1>
    <p class="intro">Every topic I've written about, most used first.</p>
    <ul class="tags tag-cloud">
      {
        tags.map(({ tag, count }) => (
          <li>
            <a class="tag" href={`/tags/${tag}`}>
              {tag} <span class="count" aria-label={`${count} ${count === 1 ? 'post' : 'posts'}`}>{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .page { padding-top: clamp(2.5rem, 8vw, 4.5rem); }
  h1 { margin: 0.5rem 0; font-size: clamp(2rem, 5vw, 2.75rem); letter-spacing: -0.03em; }
  .intro { color: var(--muted); margin: 0 0 2rem; }
  .tag-cloud { gap: 0.6rem; max-width: 48rem; }
  .tag-cloud .tag { font-size: 0.85rem; padding: 0.25rem 0.7rem; }
  .count { margin-left: 0.3rem; color: var(--accent); }
</style>
