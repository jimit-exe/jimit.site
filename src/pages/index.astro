---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Terminal from '../components/Terminal.astro';
import { site } from '../lib/site';
import { getPosts } from '../lib/posts';

const all = await getPosts();
const featured = all.filter((p) => p.data.featured);
const featuredIds = new Set(featured.map((p) => p.id));
const writeups = all.filter((p) => p.data.type === 'writeup' && !featuredIds.has(p.id)).slice(0, 4);
const projects = all.filter((p) => p.data.type === 'project' && !featuredIds.has(p.id));
---

<Base>
  <section class="hero container" aria-labelledby="hero-name">
    <p class="prompt">whoami</p>
    <h1 id="hero-name">{site.name}</h1>
    <p class="role mono">{site.role}</p>
    <p class="pitch">{site.pitch}</p>
    <div class="cta">
      <a class="btn btn-primary" href="/projects">View case studies →</a>
      <a class="btn" href="/writeups">Read writeups</a>
      <a class="btn" href="/about">About me</a>
    </div>
  </section>

  <Terminal />

  {
    featured.length > 0 && (
      <section class="section container" id="projects" aria-labelledby="featured-h">
        <div class="section-head">
          <p class="eyebrow">Selected work</p>
          <h2 id="featured-h">Evidence-based case studies</h2>
        </div>
        <ul class="card-grid">
          {featured.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    writeups.length > 0 && (
      <section class="section container" aria-labelledby="writeups-h">
        <div class="section-head row">
          <div>
            <p class="eyebrow">Latest writeups</p>
            <h2 id="writeups-h">Breaking things, methodically</h2>
          </div>
          <a class="mono more" href="/writeups">All writeups →</a>
        </div>
        <ul class="card-grid">
          {writeups.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    projects.length > 0 && (
      <section class="section container" aria-labelledby="projects-h">
        <div class="section-head row">
          <div>
            <p class="eyebrow">Projects</p>
            <h2 id="projects-h">More things I've built</h2>
          </div>
          <a class="mono more" href="/projects">All projects →</a>
        </div>
        <ul class="card-grid">
          {projects.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding-top: clamp(3rem, 10vw, 6.5rem);
    padding-bottom: clamp(1rem, 4vw, 2rem);
  }
  .hero h1 {
    margin: 0.5rem 0 0.25rem;
    font-size: clamp(2.4rem, 7vw, 4rem);
    letter-spacing: -0.035em;
  }
  .role {
    margin: 0 0 1.5rem;
    color: var(--accent);
    font-size: clamp(0.9rem, 2vw, 1.05rem);
  }
  .pitch {
    max-width: 62ch;
    margin: 0 0 2rem;
    color: var(--text);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.7;
  }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .row { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 0.5rem 1rem; }
  .more { font-size: 0.85rem; text-decoration: none; }
</style>
